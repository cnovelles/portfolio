---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import type { SocialImage } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** Root-relative canonical path; defaults to the current URL's path. */
  path?: string;
  image?: SocialImage;
}

const { title, description, path, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1a1d" media="(prefers-color-scheme: dark)" />
    <Seo title={title} description={description} path={path} image={image} />
  </head>
  <body class="min-h-screen bg-bg font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:font-medium focus:text-bg"
    >
      Skip to content
    </a>
    <main id="main" tabindex="-1" class="mx-auto max-w-5xl px-6 focus:outline-none sm:px-10">
      <slot />
    </main>
  </body>
</html>
