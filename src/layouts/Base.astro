---
import "../styles/global.css";
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url";
import bodyFont from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";
import Seo from "../components/Seo.astro";
import ThemeToggle from "../components/ThemeToggle";
import type { SocialImage } from "../lib/seo";
import { THEME_COLORS, THEME_STORAGE_KEY } from "../lib/theme";

interface Props {
  title?: string;
  description?: string;
  /** Root-relative canonical path; defaults to the current URL's path. */
  path?: string;
  image?: SocialImage;
}

const { title, description, path, image } = Astro.props;

const navLinks = [
  { label: "Experience", href: "/#experience" },
  { label: "Skills", href: "/#skills" },
  { label: "Education", href: "/#education" },
  { label: "About", href: "/#about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1a1d" media="(prefers-color-scheme: dark)" />
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY, colors: THEME_COLORS }}>
      // Pre-paint theme (see src/lib/theme.ts): stored choice wins, else the system.
      let t = null;
      try { t = localStorage.getItem(key); } catch { /* blocked storage: follow the system */ }
      if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = t;
      document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.content = colors[t]; });
    </script>
    <Seo title={title} description={description} path={path} image={image} />
  </head>
  <body class="min-h-screen bg-bg font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:font-medium focus:text-bg"
    >
      Skip to content
    </a>
    <header id="top" class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center gap-2 px-6 py-2.5 sm:gap-4 sm:px-10">
        <a
          href="/"
          class="mr-auto inline-flex min-h-11 items-center font-display text-base font-bold tracking-[-0.01em] whitespace-nowrap sm:text-lg"
        >
          <span class="min-[400px]:hidden">Christian</span>
          <span class="hidden min-[400px]:inline">Christian Gonzalez</span>
          <span class="sr-only">, home</span>
        </a>
        <nav aria-label="Sections" class="hidden md:block">
          <ul class="flex items-center gap-1">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-11 items-center rounded-full px-3 font-medium text-muted hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a
          href="/#contact"
          class="inline-flex min-h-11 items-center rounded-full bg-ink px-4 font-medium whitespace-nowrap text-bg transition-colors hover:bg-accent sm:px-5"
        >
          Let's talk
        </a>
        <ThemeToggle client:load />
      </div>
    </header>
    <main id="main" tabindex="-1" class="mx-auto max-w-5xl px-6 focus:outline-none sm:px-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-5xl border-t border-line px-6 py-10 text-[0.9375rem] text-muted sm:px-10">
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
        <p>
          © {new Date().getFullYear()} Christian Gonzalez Lopez. Built with Astro, React, and Tailwind.{" "}
          <a
            href="https://github.com/cnovelles/portfolio"
            class="font-medium text-ink underline decoration-line decoration-2 underline-offset-4 hover:decoration-accent"
          >
            View the source code<span class="sr-only">&nbsp;for this site on GitHub</span>
          </a>
        </p>
        <a
          href="#top"
          class="inline-flex min-h-11 items-center font-medium text-ink underline decoration-line decoration-2 underline-offset-4 hover:decoration-accent"
        >
          Back to top
        </a>
      </div>
    </footer>
  </body>
</html>
