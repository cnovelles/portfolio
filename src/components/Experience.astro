---
import { formatYearMonth, getExperience } from "../data/profile";

const entries = getExperience();
---

<section aria-labelledby="experience-heading" class="border-t border-line py-20 sm:py-24">
  <h2
    id="experience-heading"
    class="font-display text-[clamp(2rem,5vw,3rem)] leading-none font-bold tracking-[-0.02em]"
  >
    Experience
  </h2>

  <div class="mt-12 space-y-14">
    {
      entries.map((entry) => (
        <article class="max-w-[46em]">
          <h3 class="font-display text-2xl font-semibold tracking-[-0.01em] text-balance">
            {entry.company}
          </h3>
          {entry.title && <p class="mt-1 font-semibold text-accent">{entry.title}</p>}
          <p class="mt-1 text-[0.9375rem] text-muted">
            <time datetime={entry.start}>{formatYearMonth(entry.start)}</time>
            {" – "}
            <time datetime={entry.end}>{formatYearMonth(entry.end)}</time>
            {entry.location && <span> · {entry.location}</span>}
          </p>
          <ul class="mt-4 list-disc space-y-2.5 pl-5 leading-relaxed text-muted marker:text-accent">
            {entry.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
