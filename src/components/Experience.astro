---
import { formatYearMonth, getExperience } from "../data/profile";

const entries = getExperience();
---

<section id="experience" aria-labelledby="experience-heading" class="border-t border-line py-20 sm:py-24">
  <h2
    id="experience-heading"
    class="font-display text-[clamp(2rem,5vw,3rem)] leading-none font-bold tracking-[-0.02em]"
  >
    Experience
  </h2>

  <div class="mt-12 divide-y divide-line">
    {
      entries.map((entry, index) => (
        <article class="grid gap-x-12 gap-y-4 py-10 first:pt-0 last:pb-0 md:grid-cols-[13rem_1fr]">
          <div>
            <h3 class="font-display text-2xl font-semibold tracking-[-0.01em] text-balance">
              {entry.company}
            </h3>
            <p class="mt-1 text-[0.9375rem] text-muted">
              <time datetime={entry.start}>{formatYearMonth(entry.start)}</time>
              {" – "}
              <time datetime={entry.end}>{formatYearMonth(entry.end)}</time>
            </p>
            {entry.location && <p class="text-[0.9375rem] text-muted">{entry.location}</p>}
            {index === 0 && (
              <p class="mt-3 inline-block rounded-full border border-accent px-3 py-0.5 text-sm font-medium text-accent">
                Most recent
              </p>
            )}
          </div>

          <div class="max-w-[44em]">
            {entry.title && <p class="text-lg font-semibold text-ink">{entry.title}</p>}
            {entry.summary && <p class="mt-1 leading-relaxed text-muted">{entry.summary}</p>}
            <ul class="mt-4 list-disc space-y-2.5 pl-5 leading-relaxed text-muted marker:text-accent">
              {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            {entry.tech.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Technologies used at ${entry.company}`}>
                {entry.tech.map((tech) => (
                  <li class="rounded-full border border-line px-3 py-1 text-sm">{tech}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
