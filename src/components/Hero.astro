---
import { identity } from "../data/profile";
import HeroDiagram from "./HeroDiagram.astro";

const { resume, github, linkedin } = identity.links;

const pill =
  "inline-flex min-h-11 items-center rounded-full px-5 font-medium transition-colors";
const inlineLink =
  "font-medium text-ink underline decoration-line decoration-2 underline-offset-4 hover:decoration-accent";
---

<section
  aria-labelledby="hero-heading"
  class="grid items-center gap-x-12 gap-y-14 py-16 sm:py-24 lg:grid-cols-[1.2fr_1fr]"
>
  <div>
    <h1 id="hero-heading" class="flex items-center gap-3 font-semibold text-ink">
      <span aria-hidden="true" class="size-2.5 shrink-0 rounded-full bg-accent ring-4 ring-accent/20"></span>
      <span><span class="sr-only">{identity.name}, </span>{identity.title}</span>
    </h1>

    <div class="mt-8 max-w-[34em] space-y-6 text-[clamp(1.1875rem,2.2vw,1.375rem)] leading-relaxed text-muted">
      {
        identity.intro.map((paragraph) => (
          <p>
            {paragraph.map((segment) =>
              typeof segment === "string" ? (
                segment
              ) : (
                <a href={segment.href} class={inlineLink}>
                  {segment.text}
                </a>
              ),
            )}
          </p>
        ))
      }
    </div>

    <ul class="mt-10 flex flex-wrap items-center gap-2.5" aria-label="Primary actions">
      <li>
        <a href="#experience" class:list={[pill, "bg-ink text-bg hover:bg-accent"]}>
          Explore my work
        </a>
      </li>
      <li>
        <a
          href={resume.href}
          download
          class:list={[pill, "border-[1.5px] border-line hover:border-accent"]}
        >
          Download resume<span class="sr-only">&nbsp;(PDF)</span>
        </a>
      </li>
    </ul>

    <p class="mt-6 text-muted">
      Find me on <a href={github.href} class={inlineLink}>GitHub</a> and{" "}
      <a href={linkedin.href} class={inlineLink}>LinkedIn</a>.
    </p>
  </div>
  <HeroDiagram />
</section>
