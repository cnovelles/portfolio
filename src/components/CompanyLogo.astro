---
/*
  Company logo tile: each organization's official square logo (the same marks
  LinkedIn shows), displayed unaltered.
  Decorative: the company name is always printed next to the tile.
*/
import { Image } from "astro:assets";
import americanExpress from "../assets/logos/american-express.png";
import fiuArc from "../assets/logos/fiu-arc.png";
import pnnl from "../assets/logos/pnnl.png";
import vmware from "../assets/logos/vmware.png";
import type { ExperienceEntry } from "../data/profile";

interface Props {
  logo?: ExperienceEntry["logo"];
  monogram?: string;
  size?: "sm" | "md";
}

const { logo, monogram, size = "md" } = Astro.props;

const logos = { "american-express": americanExpress, vmware, "fiu-arc": fiuArc, pnnl } as const;

const px = size === "sm" ? 28 : 48;
const tile = size === "sm" ? "size-7 rounded-md" : "size-12 rounded-xl";
const src = logo ? logos[logo] : undefined;
---

{
  src ? (
    <Image
      src={src}
      alt=""
      width={px}
      height={px}
      densities={[1, 2]}
      class:list={["shrink-0 border border-line bg-white object-contain", tile]}
    />
  ) : (
    monogram && (
      <span
        aria-hidden="true"
        class:list={[
          "inline-flex shrink-0 items-center justify-center bg-surface font-display font-bold text-accent",
          tile,
          size === "sm" ? "text-[0.5rem]" : "text-sm",
        ]}
      >
        {monogram}
      </span>
    )
  )
}
