---
import { getSkillGroups } from "../data/profile";

const groups = getSkillGroups();
---

<section id="skills" aria-labelledby="skills-heading" class="border-t border-line py-16 sm:py-24">
  <h2
    id="skills-heading"
    class="font-display text-[clamp(2rem,5vw,2.75rem)] leading-tight font-bold tracking-[-0.02em]"
  >
    Skills
  </h2>

  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      groups.map((group) => (
        <div class="rounded-2xl border border-line p-6">
          <h3 class="font-display text-xl font-semibold tracking-[-0.01em]">{group.name}</h3>
          {group.description && <p class="mt-1 text-[0.9375rem] text-muted">{group.description}</p>}
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li class="rounded-full border border-line px-3 py-1 text-[0.9375rem]">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
